<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Crud</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/table.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>

  <body>
<nav class="navbar navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">
    </a>
  </div>
</nav>
    <div class="container py-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="titulo-pagina mb-1">Usuarios</h2>
            <p class="subtitulo-pagina mb-0">
                Administración de usuarios registrados
            </p>
        </div>

        <a href="/create" class="btn btn-primary btn-nuevo">
            <i class="fa-solid fa-user-plus me-2"></i>
            Nuevo usuario
        </a>
    </div>


    <!-- Tabla -->
    <div class="card tabla-card">

        <div class="card-header tabla-header">
            <div>
                <h5 class="mb-0">Lista de usuarios</h5>
                <small>Usuarios registrados en el sistema</small>
            </div>
        </div>

        <div class="table-responsive">
            <table id="users" class="table tabla-usuarios mb-0">
                <thead>
                    <tr class="table bg-primary text-white">
                        <th>ID</th>
                        <th>NOMBRE</th>
                        <th>APELLIDO</th>
                        <th>DOMICILIO</th>
                        <th>TELEFONO</th>
                        <th>RENTAS</th>
                        <th class="text-center">ACCIONES</th>
                    </tr>
                </thead>

                <tbody>

                    <% results.forEach((user)=>{ %>

                    <tr>

                        <td>
                            <span class="id-usuario">
                                #<%= user.id %>
                            </span>
                        </td>

                        <td>
                            <div class="usuario-nombre">
                                <%= user.nombre %>
                            </div>
                        </td>

                        <td>
                            <%= user.apellido %>
                        </td>

                        <td class="domicilio">
                            <i class="fa-solid fa-location-dot me-2"></i>
                            <%= user.domicilio %>
                        </td>

                        <td>
                            <i class="fa-solid fa-phone me-2 telefono-icon"></i>
                            <%= user.telefono %>
                        </td>

                        <td>
                            <span class="badge-rentas">
                                <%= user.cantidad_rentas %>
                            </span>
                        </td>

                        <td>
                            <div class="acciones">

                                <a href="/edit/<%= user.id %>"
                                   class="accion editar"
                                   title="Editar usuario">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                <a onclick="confirmar(<%= user.id %>)"
                                   class="accion eliminar"
                                   title="Eliminar usuario">
                                    <i class="fa-solid fa-trash"></i>
                                </a>

                                <a href="/rentas/<%= user.id %>"
                                   class="accion rentas"
                                   title="Ver rentas">
                                    <i class="fa-solid fa-eye"></i>
                                </a>

                            </div>
                        </td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>
        </div>

    </div>

</div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script>

      function confirmar(id){
        Swal.fire({
          title: "Confirma eliminar el registro?",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: "Confirmar",
        }).then((result) => {
          if (result.isConfirmed){
            window.location = '/delete/' + id;
          }

        });
      }
    </script>
  </body>
</html>