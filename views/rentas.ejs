<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Crud</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="/css/table.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">
      </a>
    </div>
  </nav>
  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="titulo-pagina mb-1">Rentas</h2>
        <p class="subtitulo-pagina mb-0">
          Administración rentas del usuario
        </p>
      </div>
    <div class="d-flex gap-2">
      <a href="/" class="btn btn-warning btn-nuevo">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Regresar
      </a>

      <a href="/createRenta/<%= usuario_id %>" class="btn btn-primary btn-nuevo">
        <i class="fa-solid fa-user-plus me-2"></i>
        Nueva Renta
      </a>
    </div>
    </div>
    <div class="card tabla-card">
      <div class="card-header tabla-header">
        <div>
          <h5 class="mb-0">Lista de rentas</h5>
          <small>Rentas del usuario registrados en el sistema</small>
        </div>
      </div>
      <div class="table-responsive">
        <table id="users" class="table tabla-usuarios mb-0">
          <thead>
            <tr class="tale bg-primary text-white">
              <th scope="col">ID</th>
              <th scope="col">ID DEL USUARIO</th>
              <th scope="col">FECHA DE RENTA</th>
              <th scope="col">FECHA DEL EVENTO</th>
              <th scope="col">HORA DE ENTREGA</th>
              <th scope="col">HORA DE RECOLECCION</th>
              <th scope="col">DIRECCION DEL EVENTO</th>
              <th scope="col">TOTAL</th>
              <th scope="col">ANTICIPO</th>
              <th scope="col">SALDO</th>
              <th scope="col">ESTADO</th>
              <th class="text-center">ACCIONES</th>
            </tr>
          </thead>
          <tbody>
            <% results.forEach((renta)=>{ %>
              <tr>
                <td><span class="id-usuario"> #<%= renta.id %></span></td>
                <td>
                  <%= renta.usuario_id %>
                </td>
                <td>
                  <%= renta.fecha_renta.toLocaleDateString('es-MX') %>
                </td>
                <td>
                  <%= renta.fecha_evento.toLocaleDateString('es-MX') %>
                </td>
                <td>
                  <%= renta.hora_entrega %>
                </td>
                <td>
                  <%= renta.hora_recogida %>
                </td>
                <td class="domicilio">
                  <i class="fa-solid fa-location-dot me-2"></i>
                  <%= renta.direccion_evento %>
                </td>
                <td><span>$<%= renta.total %></span></td>
                <td><span>$<%= renta.anticipo %></span></td>
                <td><span>$<%= renta.saldo %></span></td>
                <td>
                  <%= renta.estado %>
                </td>
                <td>
                  <div class="acciones">
                    <a href="/editRenta/<%= renta.id %>" class="accion editar" title="Editar usuario">
                      <i class="fa-solid fa-pen"></i>
                    </a>

                    <a href="#" onclick="confirmar(<%= renta.id %>); return false;" class="accion eliminar" title="Eliminar renta"><i class="fa-solid fa-trash"></i></a>
                  </div>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<script>
  function confirmar(id) {
    Swal.fire({
      title: "¿Confirma eliminar el registro?",
      text: "Esta acción no se puede deshacer.",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Confirmar",
      cancelButtonText: "Cancelar"
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = "/deleteRenta/" + id;
      }
    });
  }
</script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>